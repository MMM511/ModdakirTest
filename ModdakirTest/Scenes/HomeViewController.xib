<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24128" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24063"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" customClass="HomeViewController" customModule="ModdakirTest" customModuleProvider="target">
            <connections>
                <outlet property="view" destination="homeRoot" id="hout-view"/>
                <outlet property="profileImageView" destination="profileImage" id="hout-photo"/>
                <outlet property="nameLabel" destination="homeName" id="hout-name"/>
                <outlet property="emailLabel" destination="homeEmail" id="hout-email"/>
                <outlet property="logoutButton" destination="logoutBtn" id="hout-logout"/>
            </connections>
        </placeholder>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view clearsContextBeforeDrawing="NO" contentMode="scaleToFill" id="homeRoot">
            <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" distribution="fill" alignment="fill" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="homeStack">
                    <rect key="frame" x="24" y="270" width="345" height="312"/>
                    <subviews>
                        <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="imgBox" userLabel="Photo Container">
                            <rect key="frame" x="0.0" y="0.0" width="345" height="108"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="108" id="h-imgbox"/>
                                <constraint firstItem="profileImage" firstAttribute="centerX" secondItem="imgBox" secondAttribute="centerX" id="c-imgcx"/>
                                <constraint firstItem="profileImage" firstAttribute="centerY" secondItem="imgBox" secondAttribute="centerY" id="c-imgcy"/>
                            </constraints>
                            <subviews>
                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleToFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="profileImage">
                                    <rect key="frame" x="124" y="6" width="96" height="96"/>
                                    <constraints>
                                        <constraint firstAttribute="width" constant="96" id="w-photo"/>
                                        <constraint firstAttribute="height" constant="96" id="h-photo"/>
                                    </constraints>
                                </imageView>
                            </subviews>
                        </view>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Name" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="homeName">
                            <rect key="frame" x="0.0" y="124" width="345" height="27"/>
                            <fontDescription key="fontDescription" type="boldSystem" pointSize="22"/>
                            <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            <nil key="highlightedColor"/>
                        </label>
                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="email@example.com" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="homeEmail">
                            <rect key="frame" x="0.0" y="167" width="345" height="19"/>
                            <fontDescription key="fontDescription" type="system" pointSize="15"/>
                            <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            <nil key="highlightedColor"/>
                        </label>
                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="logoutBtn">
                            <rect key="frame" x="0.0" y="202" width="345" height="50"/>
                            <constraints>
                                <constraint firstAttribute="height" constant="50" id="h-logout"/>
                            </constraints>
                            <state key="normal" title="Log Out"/>
                            <buttonConfiguration key="configuration" style="filled" title="Log Out">
                                <color key="baseForegroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <color key="baseBackgroundColor" systemColor="systemRedColor"/>
                            </buttonConfiguration>
                            <connections>
                                <action selector="logoutTapped:" destination="-1" eventType="touchUpInside" id="act-logout"/>
                            </connections>
                        </button>
                    </subviews>
                </stackView>
            </subviews>
            <viewLayoutGuide key="safeArea" id="homeSafe"/>
            <color key="backgroundColor" red="0.0" green="0.9727097602739726" blue="0.89000000000000001" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
            <constraints>
                <constraint firstItem="homeStack" firstAttribute="leading" secondItem="homeSafe" secondAttribute="leading" constant="24" id="hc-lead"/>
                <constraint firstItem="homeSafe" firstAttribute="trailing" secondItem="homeStack" secondAttribute="trailing" constant="24" id="hc-trail"/>
                <constraint firstItem="homeStack" firstAttribute="centerY" secondItem="homeSafe" secondAttribute="centerY" id="hc-cy"/>
                <constraint firstItem="homeStack" firstAttribute="top" secondItem="homeSafe" secondAttribute="top" relation="greaterThanOrEqual" constant="16" id="hc-top"/>
                <constraint firstItem="homeSafe" firstAttribute="bottom" secondItem="homeStack" secondAttribute="bottom" relation="greaterThanOrEqual" constant="16" id="hc-bot"/>
            </constraints>
            <point key="canvasLocation" x="137" y="134"/>
        </view>
    </objects>
</document>
